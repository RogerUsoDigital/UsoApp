{
    "name": "app/legacy-api",
    "description": "Estrutura inicial de API REST em PHP 8.3 puro",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "require": {
        "php": ">=8.3",
        "guzzlehttp/guzzle": "^7.8",
        "google/cloud-bigquery": "^1.33",
        "vlucas/phpdotenv": "^5.6",
        "zircote/swagger-php": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    }
}
